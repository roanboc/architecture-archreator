# Python bytecode from running the checks in scripts/.
__pycache__/
*.pyc

# Personal, machine-local Claude Code settings — never shared.
# Project-scoped settings (.claude/settings.json) ARE committed.
.claude/settings.local.json

# Everything the method generates — briefs, the portal configuration and
# whatever it builds. Regenerated fresh on every run; a copy in the history
# is a copy that can go stale.
.archreator/

# model.json, written by the plugin's model.py export for a consumer that
# cannot read Markdown. Same rule: derived, never committed.
.model/

# Where the pre-0.2 tooling staged its portal and PDF. Nothing writes it any
# more; ignored so a stale local copy never lands in history.
.docs/
